rules_version = '2';

// 공모픽 보안 규칙
// - 가족 그룹(households)의 memberEmails 에 내 Google 이메일이 있어야 그룹 데이터를 읽고 쓸 수 있다.
// - 계좌·청약 기록은 가족 모두 읽을 수 있지만, 본인(ownerUid)만 수정할 수 있다.
// - 카카오 토큰(kakaoTokens)은 클라이언트가 절대 접근할 수 없다(서버 스크립트의 Admin SDK 전용).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isMember(hid) {
      return signedIn() && myEmail() in household(hid).memberEmails;
    }
    function isAdmin(hid) {
      return isMember(hid) && request.auth.uid == household(hid).adminUid;
    }
    function validMembers(list) {
      return list is list && list.size() >= 1 && list.size() <= 4;
    }

    match /households/{hid} {
      // 목록 쿼리(where memberEmails array-contains 내 이메일)와 단건 조회 모두 허용
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      // 새 그룹: 만드는 사람이 관리자가 되고, 허용 목록에 본인 이메일이 포함되어야 한다.
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && validMembers(request.resource.data.memberEmails)
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.keys().hasOnly(['name', 'adminUid', 'memberEmails', 'createdAt']);

      // 관리자만 허용 목록 수정. 관리자 본인은 목록에서 빠질 수 없고, adminUid 는 바꿀 수 없다.
      allow update: if signedIn()
        && request.auth.uid == resource.data.adminUid
        && request.resource.data.adminUid == resource.data.adminUid
        && validMembers(request.resource.data.memberEmails)
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails', 'name']);

      allow delete: if false;

      match /ipos/{iid} {
        allow read: if isMember(hid);
        // 종목 보정은 가족 누구나 가능. 수정자 기록(updatedBy)은 본인 uid 여야 한다.
        allow create, update: if isMember(hid) && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isAdmin(hid);
      }

      match /brokers/{bid} {
        allow read, write: if isMember(hid);
      }

      match /members/{uid} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email.lower() == myEmail();
        allow delete: if false;
      }

      match /accounts/{aid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if isMember(hid)
          && resource.data.ownerUid == request.auth.uid
          && (request.method == 'delete' || request.resource.data.ownerUid == request.auth.uid);
      }

      match /subscriptions/{sid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if isMember(hid)
          && resource.data.ownerUid == request.auth.uid
          && (request.method == 'delete' || request.resource.data.ownerUid == request.auth.uid);
      }
    }

    // 카카오 토큰 등 서버 전용 데이터
    match /kakaoTokens/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
